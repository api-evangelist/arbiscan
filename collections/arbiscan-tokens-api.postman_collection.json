    {
      "id": "153bdfaf-2fb1-49ad-9ed0-7152c02467da",
      "name": "Tokens",
      "description": {
        "content": "ERC-20, ERC-721, and ERC-1155 token supply, holders, and metadata",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e9c79192-2741-4cc3-85ab-a66c2b6c25de",
          "name": "Arbiscan API Endpoint",
          "request": {
            "name": "Arbiscan API Endpoint",
            "description": {
              "content": "All Arbiscan API calls are issued against the Etherscan V2 unified endpoint. Set chainid=42161 for Arbitrum One. The module and action parameters select the operation. An API key is required for all calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "chainid",
                  "value": "<integer>",
                  "description": "(Required) Numeric chain ID. Use 42161 for Arbitrum One. Other Arbitrum networks: 42170 (Arbitrum Nova), 421614 (Arbitrum Sepolia testnet)."
                },
                {
                  "disabled": false,
                  "key": "module",
                  "value": "<string>",
                  "description": "(Required) API module name. One of: account, contract, transaction, block, logs, token, gastracker, stats."
                },
                {
                  "disabled": false,
                  "key": "action",
                  "value": "<string>",
                  "description": "(Required) Action within the selected module. See module-specific documentation for available actions."
                },
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "Arbitrum One address (checksummed or lowercase) for account or token operations."
                },
                {
                  "disabled": false,
                  "key": "contractaddress",
                  "value": "<string>",
                  "description": "Smart contract or token contract address."
                },
                {
                  "disabled": false,
                  "key": "txhash",
                  "value": "<string>",
                  "description": "Transaction hash for transaction-specific queries."
                },
                {
                  "disabled": false,
                  "key": "blockno",
                  "value": "<integer>",
                  "description": "Block number for block-specific queries."
                },
                {
                  "disabled": false,
                  "key": "startblock",
                  "value": "<integer>",
                  "description": "Starting block number for range queries (default 0)."
                },
                {
                  "disabled": false,
                  "key": "endblock",
                  "value": "<integer>",
                  "description": "Ending block number for range queries (default 99999999)."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number for paginated results (default 1)."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Number of results per page (max 10000, default 10)."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort order for results."
                },
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "Block tag (latest, earliest, pending) or hex block number for balance queries."
                },
                {
                  "disabled": false,
                  "key": "topic0",
                  "value": "<string>",
                  "description": "Keccak-256 hash of the event signature for log filtering."
                },
                {
                  "disabled": false,
                  "key": "topic1",
                  "value": "<string>",
                  "description": "Second event topic for log filtering."
                },
                {
                  "disabled": false,
                  "key": "topic0_1_opr",
                  "value": "<string>",
                  "description": "Operator between topic0 and topic1 (and or or)."
                },
                {
                  "disabled": false,
                  "key": "fromBlock",
                  "value": "<integer>",
                  "description": "Starting block for log queries."
                },
                {
                  "disabled": false,
                  "key": "toBlock",
                  "value": "<integer>",
                  "description": "Ending block for log queries."
                },
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<integer>",
                  "description": "Unix timestamp for block-by-timestamp queries."
                },
                {
                  "disabled": false,
                  "key": "closest",
                  "value": "<string>",
                  "description": "Direction to find closest block to timestamp (before or after)."
                },
                {
                  "disabled": false,
                  "key": "boolean",
                  "value": "<string>",
                  "description": "Boolean value for proxy-verification queries (true or false)."
                },
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) Your Etherscan/Arbiscan API key from https://arbiscan.io/myapikey"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
